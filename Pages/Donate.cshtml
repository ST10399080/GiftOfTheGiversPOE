@page
@model GiftOfTheGiversPOE.Pages.DonateModel

@{
    ViewData["Title"] = "Donate";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1>Make a Donation</h1>

        <p class="lead">
            Support humanitarian and disaster relief efforts.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Donation Details
                    </h2>


                    <form method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Donation Frequency -->

                        <div class="mb-3">

                            <label class="form-label">
                                Donation Frequency
                            </label>

                            <select asp-for="Donation.DonationType"
                                    class="form-select">

                                <option value="One-Time">
                                    One-time
                                </option>

                                <option value="Recurring">
                                    Recurring
                                </option>

                            </select>

                        </div>


                        <!-- Amount -->

                        <div class="mb-3">

                            <label asp-for="Donation.Amount"
                                   class="form-label">

                                Donation Amount

                            </label>

                            <input asp-for="Donation.Amount"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter donation amount"
                                   min="1"
                                   step="0.01" />

                            <span asp-validation-for="Donation.Amount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Currency -->

                        <div class="mb-3">

                            <label class="form-label">
                                Currency
                            </label>

                            <select asp-for="Donation.Currency"
                                    class="form-select">

                                <option value="ZAR">
                                    ZAR
                                </option>

                                <option value="USD">
                                    USD
                                </option>

                                <option value="EUR">
                                    EUR
                                </option>

                            </select>

                        </div>


                        <!-- Fund Option -->

                        <div class="mb-3">

                            <label class="form-label">
                                Fund Option
                            </label>

                            <select asp-for="Donation.FundOption"
                                    class="form-select">

                                <option value="General Relief">
                                    General Relief
                                </option>

                                <option value="Disaster Response">
                                    Disaster Response
                                </option>

                                <option value="Hunger Relief">
                                    Hunger Relief
                                </option>

                                <option value="Healthcare">
                                    Healthcare
                                </option>

                                <option value="Water Provision">
                                    Water Provision
                                </option>

                            </select>

                        </div>


                        <!-- Donor Type -->

                        <div class="mb-3">

                            <label class="form-label">
                                Donor Type
                            </label>

                            <select asp-for="Donation.DonorType"
                                    class="form-select">

                                <option value="Registered Donor">
                                    Registered Donor
                                </option>

                                <option value="Anonymous">
                                    Anonymous Donation
                                </option>

                            </select>

                        </div>


                        <!-- Donor Name -->

                        <div class="mb-3" id="donorNameSection">

                            <label asp-for="Donation.DonorName"
                                   class="form-label">

                                Donor Name

                            </label>

                            <input asp-for="Donation.DonorName"
                                   class="form-control"
                                   placeholder="Enter your name" />

                            <span asp-validation-for="Donation.DonorName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Donor Email -->

                        <div class="mb-3">

                            <label asp-for="Donation.DonorEmail"
                                   class="form-label">

                                Email Address

                            </label>

                            <input asp-for="Donation.DonorEmail"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email address (optional)" />

                            <span asp-validation-for="Donation.DonorEmail"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Submit -->

                        <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                Continue with Donation

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        const donorType =
            document.getElementById("Donation_DonorType");

        const donorNameSection =
            document.getElementById("donorNameSection");

        const donorNameInput =
            document.getElementById("Donation_DonorName");


        function updateDonorFields() {

            if (donorType.value === "Anonymous") {

                donorNameSection.style.display = "none";

                donorNameInput.value = "";

            }
            else {

                donorNameSection.style.display = "block";

            }

        }


        donorType.addEventListener(
            "change",
            updateDonorFields
        );


        updateDonorFields();

    </script>
}