@page
@model GiftOfTheGiversPOE.Pages.VolunteerModel

@{
    ViewData["Title"] = "Volunteer";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1>Volunteer</h1>

        <p class="lead">
            Register your interest in supporting disaster
            relief efforts.
        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Volunteer Application
                    </h2>

                    <form method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="Volunteer.FirstName"
                                   class="form-label">
                                First Name
                            </label>

                            <input asp-for="Volunteer.FirstName"
                                   class="form-control"
                                   placeholder="Enter first name" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Surname"
                                   class="form-label">
                                Surname
                            </label>

                            <input asp-for="Volunteer.Surname"
                                   class="form-control"
                                   placeholder="Enter surname" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.PhoneNumber"
                                   class="form-label">
                                Contact Number
                            </label>

                            <input asp-for="Volunteer.PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter contact number" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Volunteer.Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter Email address" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Address"
                                   class="form-label">
                                Address
                            </label>

                            <textarea asp-for="Volunteer.Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter your address"></textarea>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Discipline"
                                   class="form-label">
                                Volunteer Discipline
                            </label>

                            <select asp-for="Volunteer.Discipline"
                                    class="form-select">

                                <option value="">
                                    Select a discipline
                                </option>

                                <option value="Medical Personnel">
                                    Medical Personnel
                                </option>

                                <option value="Search and Rescue Personnel">
                                    Search and Rescue Personnel
                                </option>

                                <option value="Psycho-Social Personnel">
                                    Psycho-Social Personnel
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Skills"
                                   class="form-label">
                                Skills
                            </label>

                            <input asp-for="Volunteer.Skills"
                                   class="form-control"
                                   placeholder="Enter your skills" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.ProfessionalRegistrationNumber"
                                   class="form-label">
                                HPCSA Registration Number
                            </label>

                            <input asp-for="Volunteer.ProfessionalRegistrationNumber"
                                   class="form-control"
                                   placeholder="If applicable" />

                            <div class="form-text">
                                Required where applicable for
                                registered healthcare professionals.
                            </div>

                        </div>

                        <h3 class="mt-4 mb-3">
                            Next of Kin
                        </h3>

                        <div class="mb-3">

                            <label asp-for="Volunteer.NextOfKinName"
                                   class="form-label">
                                Next of Kin Name
                            </label>

                            <input asp-for="Volunteer.NextOfKinName"
                                   class="form-control"
                                   placeholder="Enter next of kin name" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.NextOfKinPhone"
                                   class="form-label">
                                Next of Kin Contact Number
                            </label>

                            <input asp-for="Volunteer.NextOfKinPhone"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter next of kin contact number" />

                        </div>

                        <h3 class="mt-4 mb-3">
                            Availability
                        </h3>

                        <div class="mb-3">

                            <label asp-for="Volunteer.Availability"
                                   class="form-label">
                                Availability
                            </label>

                            <select asp-for="Volunteer.Availability"
                                    class="form-select">

                                <option value="">
                                    Select availability
                                </option>

                                <option value="Emergency / Deployment Ready">
                                    Emergency / Deployment Ready
                                </option>

                                <option value="Full-Time">
                                    Full-Time
                                </option>

                                <option value="Part-Time / Standby">
                                    Part-Time / Standby
                                </option>

                                <option value="Specific Dates">
                                    Specific Dates
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.GeographicFlexibility"
                                   class="form-label">
                                Geographic Flexibility
                            </label>

                            <select asp-for="Volunteer.GeographicFlexibility"
                                    class="form-select">

                                <option value="">
                                    Select an option
                                </option>

                                <option value="Local Area Only">
                                    Local Area Only
                                </option>

                                <option value="Within South Africa">
                                    Within South Africa
                                </option>

                                <option value="International Deployment">
                                    International Deployment
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Volunteer.AdditionalInformation"
                                   class="form-label">
                                Volunteer Form Submission
                            </label>

                            <textarea asp-for="Volunteer.AdditionalInformation"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Provide any additional information about your skills, experience or availability"></textarea>

                        </div>

                        <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">

                                Submit Volunteer Application

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}