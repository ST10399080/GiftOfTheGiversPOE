@page
@model GiftOfTheGiversPOE.Pages.DonationSuccessModel

@{
    ViewData["Title"] = "Donation Certificate";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1>Thank You for Your Donation</h1>

        <p class="lead">
            Your donation has been successfully recorded.
        </p>

    </div>


    @if (Model.Donation != null)
    {
        <div class="row justify-content-center">

            <div class="col-lg-8">

                <!-- Tax Certificate -->

                <div class="card shadow-sm border-0">

                    <div class="card-body p-5">

                        <div class="text-center mb-4">

                            <h2 class="fw-bold">
                                GIFT OF THE GIVERS
                            </h2>

                            <h3 class="mt-3">
                                Donation Tax Certificate
                            </h3>

                            <p class="text-muted">
                                Placeholder Certificate
                            </p>

                        </div>


                        <hr />


                        <div class="row mb-3">

                            <div class="col-sm-6">

                                <strong>
                                    Certificate Number
                                </strong>

                                <p>
                                    @Model.Donation.TaxCertificateNumber
                                </p>

                            </div>

                            <div class="col-sm-6">

                                <strong>
                                    Donation Date
                                </strong>

                                <p>
                                    @Model.Donation.DonationDate.ToString(
                                        "dd MMMM yyyy")
                                </p>

                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-sm-6">

                                <strong>
                                    Donor
                                </strong>

                                <p>
                                    @Model.Donation.DonorName
                                </p>

                            </div>

                            <div class="col-sm-6">

                                <strong>
                                    Donor Type
                                </strong>

                                <p>
                                    @Model.Donation.DonorType
                                </p>

                            </div>

                        </div>


                        <div class="row mb-3">

                            <div class="col-sm-6">

                                <strong>
                                    Donation Amount
                                </strong>

                                <p class="fs-5">
                                    @Model.Donation.Currency
                                    @Model.Donation.Amount.ToString("N2")
                                </p>

                            </div>

                            <div class="col-sm-6">

                                <strong>
                                    Donation Frequency
                                </strong>

                                <p>
                                    @Model.Donation.DonationType
                                </p>

                            </div>

                        </div>


                        <div class="row mb-4">

                            <div class="col-sm-6">

                                <strong>
                                    Fund
                                </strong>

                                <p>
                                    @Model.Donation.FundOption
                                </p>

                            </div>

                            <div class="col-sm-6">

                                <strong>
                                    Email
                                </strong>

                                <p>
                                    @(Model.Donation.DonorEmail
                                        ?? "Not provided")
                                </p>

                            </div>

                        </div>


                        <hr />


                        <div class="text-center mt-4">

                            <p class="mb-1">
                                Thank you for supporting humanitarian
                                and disaster relief efforts.
                            </p>

                            <p class="text-muted small mb-0">
                                This certificate is a placeholder
                                generated for this academic project.
                                It does not constitute an official
                                tax certificate or proof of payment.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Actions -->

                <div class="text-center mt-4">

                    <button type="button"
                            class="btn btn-primary me-2"
                            onclick="window.print()">

                        Print / Save Certificate

                    </button>

                    <a asp-page="/Index"
                       class="btn btn-outline-secondary">

                        Return to Home

                    </a>

                </div>


                <div class="alert alert-info mt-4">

                    <strong>Academic Project:</strong>

                    Payment processing is simulated. No real payment
                    has been taken. This certificate is a placeholder
                    for demonstration purposes.

                </div>

            </div>

        </div>
    }

</div>