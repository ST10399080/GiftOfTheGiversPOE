@page "{id:int}"
@model GiftOfTheGiversPOE.Pages.Employee.ProjectUpdatesModel

@{
    ViewData["Title"] = "Project Updates";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>Project Updates</h1>

            <p class="text-muted mb-0">
                View and post updates for this relief project.
            </p>

        </div>

        <a asp-page="/Employee/Projects"
           class="btn btn-outline-secondary">

            Back to Projects

        </a>

    </div>


    @if (Model.Project != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h2 class="h4">
                    @Model.Project.ProjectName
                </h2>

                <p class="mb-1">
                    <strong>Location:</strong>
                    @Model.Project.Location
                </p>

                <p class="mb-0">
                    <strong>Status:</strong>
                    @Model.Project.Status
                </p>

            </div>

        </div>
    }


    <!-- Post Update Form -->

    <div class="card shadow-sm mb-5">

        <div class="card-body p-4">

            <h2 class="h4 mb-3">
                Post Project Update
            </h2>

            <p class="text-muted">
                Add information about the progress or current
                situation of this relief project.
            </p>

            <form method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="UpdateText"
                           class="form-label">
                        Update
                    </label>

                    <textarea asp-for="UpdateText"
                              class="form-control"
                              rows="5"
                              placeholder="Enter the latest project update..."></textarea>

                    <span asp-validation-for="UpdateText"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    Post Update

                </button>

            </form>

        </div>

    </div>


    <!-- Existing Updates -->

    <div>

        <h2 class="mb-4">
            Previous Updates
        </h2>


        @if (Model.Updates.Count == 0)
        {
            <div class="alert alert-info">

                No updates have been posted for this project yet.

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var update in Model.Updates)
                {
                    <div class="col-12">

                        <div class="card shadow-sm">

                            <div class="card-body">

                                <p class="text-muted mb-2">

                                    @update.UpdateDate.ToString(
                                        "dd MMMM yyyy, HH:mm")

                                </p>

                                <p class="mb-0">

                                    @update.UpdateText

                                </p>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}