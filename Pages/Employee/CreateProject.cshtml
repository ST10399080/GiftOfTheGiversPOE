@page
@model GiftOfTheGiversPOE.Pages.Employee.CreateProjectModel

@{
    ViewData["Title"] = "Create Relief Project";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Create Relief Project</h1>

            <p class="text-muted mb-0">
                Add a new relief project to the system.
            </p>
        </div>

        <a asp-page="/Employee/Projects"
           class="btn btn-outline-secondary">
            Back to Projects
        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body p-4">

            <form method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Project Name -->

                <div class="mb-3">

                    <label asp-for="Project.ProjectName"
                           class="form-label">
                        Project Name
                    </label>

                    <input asp-for="Project.ProjectName"
                           class="form-control"
                           placeholder="Enter the project name" />

                    <span asp-validation-for="Project.ProjectName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Location -->

                <div class="mb-3">

                    <label asp-for="Project.Location"
                           class="form-label">
                        Location
                    </label>

                    <input asp-for="Project.Location"
                           class="form-control"
                           placeholder="Enter the project location" />

                    <span asp-validation-for="Project.Location"
                          class="text-danger">
                    </span>

                </div>


                <!-- Status -->

                <div class="mb-3">

                    <label asp-for="Project.Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Project.Status"
                            class="form-select">

                        <option value="Active">
                            Active
                        </option>

                        <option value="Planning">
                            Planning
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                        <option value="Cancelled">
                            Cancelled
                        </option>

                    </select>

                    <span asp-validation-for="Project.Status"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->

                <div class="mb-3">

                    <label asp-for="Project.Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Project.Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe the relief project"></textarea>

                    <span asp-validation-for="Project.Description"
                          class="text-danger">
                    </span>

                </div>


                <!-- Start Date -->

                <div class="mb-3">

                    <label asp-for="Project.StartDate"
                           class="form-label">
                        Start Date
                    </label>

                    <input asp-for="Project.StartDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Project.StartDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- End Date -->

                <div class="mb-4">

                    <label asp-for="Project.EndDate"
                           class="form-label">
                        End Date
                        <span class="text-muted">
                            (Optional)
                        </span>
                    </label>

                    <input asp-for="Project.EndDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Project.EndDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Project
                    </button>

                    <a asp-page="/Employee/Projects"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}