@page

@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1>About Gift of the Givers</h1>

        <p class="lead">
            Disaster relief and humanitarian assistance
        </p>

    </div>


    <!-- About -->
    <section class="mb-5">

        <h2>About the Organisation</h2>

        <p>
            Gift of the Givers is a humanitarian organisation
            involved in disaster response and the provision of
            assistance to communities affected by emergencies
            and humanitarian crises.
        </p>

        <p>
            The organisation provides assistance in areas including
            disaster response, hunger alleviation, water provision,
            healthcare, education and human development.
        </p>

    </section>

    <section class="mb-5">

        <div class="text-center mb-5">

            <h2>
                Areas Supported by the System
            </h2>

            <p class="text-muted">
                The system supports key areas of humanitarian
                and disaster relief management.
            </p>

        </div>


        <div class="row g-4">

            <!-- Card 1 -->

            <div class="col-md-6">

                <div class="image-card">

                    <div class="image-card-image">

                        <img src="~/images/cardimage1.jpg"
                             alt="Disaster response" />

                    </div>

                    <div class="image-card-content">

                        <h3>
                            Disaster Response
                        </h3>

                        <p>
                            Support the management of relief
                            projects responding to disasters
                            and humanitarian emergencies.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Card 2 -->

            <div class="col-md-6">

                <div class="image-card">

                    <div class="image-card-image">

                        <img src="~/images/cardimage2.jpg"
                             alt="Healthcare assistance" />

                    </div>

                    <div class="image-card-content">

                        <h3>
                            Healthcare
                        </h3>

                        <p>
                            Support humanitarian healthcare
                            initiatives and assistance provided
                            to communities in need.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Card 3 -->

            <div class="col-md-6">

                <div class="image-card">

                    <div class="image-card-image">

                        <img src="~/images/cardimage3.jpg"
                             alt="Water provision" />

                    </div>

                    <div class="image-card-content">

                        <h3>
                            Water Provision
                        </h3>

                        <p>
                            Support relief activities focused
                            on providing communities with access
                            to essential water resources.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Card 4 -->

            <div class="col-md-6">

                <div class="image-card">

                    <div class="image-card-image">

                        <img src="~/images/cardimage4.jpg"
                             alt="Humanitarian assistance" />

                    </div>

                    <div class="image-card-content">

                        <h3>
                            Humanitarian Assistance
                        </h3>

                        <p>
                            Support the coordination of volunteers,
                            projects and resources involved in
                            humanitarian relief.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Main Areas -->
    <section>

        <h2 class="mb-4">
            Areas Supported by the System
        </h2>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h3>Relief Projects</h3>

                        <p>
                            Employees can manage ongoing relief
                            projects and provide project updates.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h3>Volunteers</h3>

                        <p>
                            The system allows volunteers to submit
                            their information and availability.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h3>Donations</h3>

                        <p>
                            Donors can make one-time or recurring
                            contributions to support humanitarian
                            activities.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

</div>