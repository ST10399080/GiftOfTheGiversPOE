@page

@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1>Contact Us</h1>

        <p class="lead">
            Get in touch with Gift of the Givers.
        </p>

    </div>


    <div class="row g-4">


        <!-- Contact Information -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Contact Information
                    </h2>


                    <h3>South Africa Call Centre</h3>

                    <p>
                        0800 786 911
                    </p>


                    <h3 class="mt-4">
                        Email
                    </h3>

                    <p>
                        info@giftofthegivers.org
                    </p>


                    <h3 class="mt-4">
                        Offices
                    </h3>

                    <p>
                        Gift of the Givers has offices and
                        operations in several locations.
                    </p>

                    <p>
                        Pietermaritzburg<br />
                        Durban<br />
                        Lenasia<br />
                        Johannesburg<br />
                        Cape Town<br />
                        East London
                    </p>

                </div>

            </div>

        </div>


        <!-- Contact Form -->

        <div class="col-md-6">

            <div class="card h-100 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Send a Message
                    </h2>


                    <div class="mb-3">

                        <label class="form-label">
                            Name
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter your name" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="Enter your email" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Subject
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter message subject" />

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            Message
                        </label>

                        <textarea class="form-control"
                                  rows="6"
                                  placeholder="Enter your message">
                        </textarea>

                    </div>


                    <div class="d-grid">

                        <button type="button"
                                class="btn btn-primary">

                            Send Message

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>