@page
@model GiftOfTheGiversPOE.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    .login-page {
        min-height: 75vh !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 4rem 1rem !important;
    }

    .login-card {
        width: 100% !important;
        max-width: 520px !important;
        margin: 0 auto !important;
        background: #FFFFFF !important;
        border: none !important;
        border-radius: 20px !important;
        overflow: hidden !important;
        box-shadow: 0 20px 50px rgba(11, 61, 46, 0.20) !important;
    }

    .login-header {
        background: linear-gradient(135deg, #0B3D2E 0%, #1F6B4F 100%) !important;
        padding: 3.5rem 2rem !important;
        text-align: center !important;
        border-bottom: 6px solid #D4AF37 !important;
    }

        .login-header h1 {
            color: #FFFFFF !important;
            font-size: 2.6rem !important;
            font-weight: 700 !important;
            margin: 0 0 0.75rem 0 !important;
        }

        .login-header p {
            color: #FFFFFF !important;
            opacity: 0.9 !important;
            margin: 0 !important;
            font-size: 1rem !important;
        }

    .login-body {
        background: #FFFFFF !important;
        padding: 3rem !important;
    }

    .login-introduction {
        text-align: center !important;
        margin-bottom: 2rem !important;
    }

        .login-introduction p {
            color: #66736C !important;
            margin: 0 !important;
        }

    .login-body .form-label {
        display: block !important;
        color: #0B3D2E !important;
        font-weight: 700 !important;
        margin-bottom: 0.6rem !important;
    }

    .login-body .form-control {
        display: block !important;
        width: 100% !important;
        min-height: 52px !important;
        padding: 0.75rem 1rem !important;
        background: #FFFFFF !important;
        color: #17221D !important;
        border: 2px solid #DCE6E0 !important;
        border-radius: 9px !important;
        box-shadow: none !important;
    }

        .login-body .form-control:focus {
            border-color: #D4AF37 !important;
            outline: none !important;
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15) !important;
        }

    .login-submit {
        width: 100% !important;
        min-height: 54px !important;
        margin-top: 0.5rem !important;
        background: linear-gradient(135deg, #0B3D2E, #145A42) !important;
        border: none !important;
        border-radius: 9px !important;
        color: #FFFFFF !important;
        font-size: 1.05rem !important;
        font-weight: 700 !important;
    }

        .login-submit:hover {
            background: #1F6B4F !important;
            color: #FFFFFF !important;
        }

    .login-body .text-danger {
        color: #B42318 !important;
    }

    @@media (max-width: 767px) {

        .login-page {
            padding: 2rem 0.75rem !important;
        }

        .login-header {
            padding: 2.5rem 1.5rem !important;
        }

            .login-header h1 {
                font-size: 2.1rem !important;
            }

        .login-body {
            padding: 2rem 1.5rem !important;
        }
    }
</style>

<div class="login-page">

    <div class="login-card">

        <!-- Login Header -->

        <div class="login-header">

            <h1>
                Welcome Back
            </h1>

            <p>
                Sign in to your Gift of the Givers account
            </p>

        </div>

        <!-- Login Form -->

        <div class="login-body">

            <div class="login-introduction">

                <p>
                    Enter your details below to continue.
                </p>

            </div>

            <form method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"
                     class="text-danger mb-4">
                </div>

                @if (!string.IsNullOrEmpty(Model.DebugMessage))
                {
                    <div class="alert alert-info mb-4">
                        @Model.DebugMessage
                    </div>
                }

                <!-- Email -->

                <div class="mb-4">

                    <label asp-for="Input.Email"
                           class="form-label">

                        Email Address

                    </label>

                    <input type="text"
                           name="Input.Email"
                           id="Input_Email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="Enter your email address" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->

                <div class="mb-4">

                    <label asp-for="Input.Password"
                           class="form-label">

                        Password

                    </label>

                    <input type="password"
                           name="Input.Password"
                           id="Input_Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- Login Button -->

                <div class="d-grid">

                    <button type="submit"
                            class="btn btn-primary btn-lg login-submit">

                        Log in

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}